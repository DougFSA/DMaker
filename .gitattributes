# Texto sempre com LF no repositório e no checkout (evita o ruído de CRLF do Windows)
* text=auto eol=lf

# Scripts do Windows mantêm CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.otf binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
