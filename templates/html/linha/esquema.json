{
  "title": "Linha",
  "description": "Uma linha que se desenha de um ponto até outro, com um rótulo na ponta (por exemplo, ligando o prédio ao mapa com \"2 quadras da praia\"). Os pontos são frações da área do modelo.",
  "size": [900, 500],
  "area": { "x": 0.5, "y": 0.27, "width": 0.72, "height": 0.225 },
  "duration": 4,
  "example": { "rotulo": "2 quadras da praia", "rotulo_inicio": "o prédio" },
  "params": {
    "de_x": {
      "type": "number",
      "label": "Ponto de partida, posição horizontal",
      "description": "De 0 (borda esquerda da área) a 1 (borda direita).",
      "default": 0.12,
      "min": 0,
      "max": 1
    },
    "de_y": {
      "type": "number",
      "label": "Ponto de partida, posição vertical",
      "description": "De 0 (topo da área) a 1 (base).",
      "default": 0.75,
      "min": 0,
      "max": 1
    },
    "ate_x": {
      "type": "number",
      "label": "Ponto de chegada, posição horizontal",
      "default": 0.88,
      "min": 0,
      "max": 1
    },
    "ate_y": {
      "type": "number",
      "label": "Ponto de chegada, posição vertical",
      "default": 0.25,
      "min": 0,
      "max": 1
    },
    "rotulo": {
      "type": "text",
      "label": "Rótulo na ponta",
      "description": "Texto que aparece na chegada da linha, quando ela termina de se desenhar.",
      "default": "",
      "max_length": 40
    },
    "rotulo_inicio": {
      "type": "text",
      "label": "Rótulo na partida",
      "description": "Texto junto ao ponto de partida (opcional).",
      "default": "",
      "max_length": 40
    },
    "pontas": {
      "type": "choice",
      "label": "Pontas",
      "description": "bolinha põe uma bolinha em cada ponta; seta põe uma seta na chegada; nenhuma deixa a linha limpa.",
      "default": "bolinha",
      "options": ["bolinha", "seta", "nenhuma"]
    },
    "espessura": {
      "type": "number",
      "label": "Espessura (px)",
      "default": 8,
      "min": 2,
      "max": 40
    },
    "tracejada": {
      "type": "bool",
      "label": "Linha tracejada",
      "default": false
    },
    "duracao": {
      "type": "number",
      "label": "Tempo desenhando (s)",
      "default": 1,
      "min": 0.1,
      "max": 30
    },
    "easing": {
      "type": "choice",
      "label": "Ritmo",
      "default": "entrada-saida",
      "options": ["suave", "entrada-saida", "linear"]
    },
    "cor": {
      "type": "color",
      "label": "Cor da linha",
      "default": "accent"
    },
    "cor_texto": {
      "type": "color",
      "label": "Cor dos rótulos",
      "default": "white"
    },
    "sombra": {
      "type": "bool",
      "label": "Sombra suave",
      "default": true
    }
  }
}
