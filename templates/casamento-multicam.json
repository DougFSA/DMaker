{
  "description": "Cerimônia de casamento multicâmera: câmera principal, câmera secundária e áudio externo sincronizados por áudio.",
  "params": {
    "cam_principal": {
      "description": "Câmera principal, referência de tempo da sessão",
      "type": "path",
      "required": true
    },
    "cam_secundaria": {
      "description": "Câmera secundária, sincronizada por áudio",
      "type": "path",
      "required": true
    },
    "audio_externo": {
      "description": "Gravador externo (lapela do celebrante, mesa de som), sincronizado por áudio",
      "type": "path",
      "required": true
    },
    "nomes": {
      "description": "Nomes do casal",
      "default": "Ana e Carlos",
      "type": "text"
    },
    "data": {
      "description": "Data da cerimônia",
      "default": "27 de dezembro de 2025",
      "type": "text"
    }
  },
  "name": "casamento-cerimonia",
  "output": { "preset": "youtube/video", "quality": "high" },
  "sources": {
    "principal": { "src": "{{cam_principal}}", "label": "Câmera principal" },
    "secundaria": { "src": "{{cam_secundaria}}", "sync": "auto", "label": "Câmera secundária" },
    "externo": { "src": "{{audio_externo}}", "sync": "auto", "label": "Áudio externo" }
  },
  "master": "principal",
  "timeline": [
    { "type": "card", "title": "{{nomes}}", "subtitle": "{{data}}", "duration": 4, "motion": "zoom-in" },
    { "type": "clip", "source": "principal", "transition": { "type": "fade", "duration": 1.0 }, "label": "cerimônia" },
    { "type": "clip", "source": "secundaria", "transition": { "type": "cut" }, "label": "outro ângulo" },
    { "type": "card", "title": "Obrigado por celebrar com a gente", "duration": 5, "variant": "dark", "transition": { "type": "fade", "duration": 1.2 } }
  ],
  "overlays": [
    { "type": "text", "text": "{{nomes}}", "secondary": "Cerimônia", "role": "lower-third", "start": 6, "end": 14 }
  ],
  "audio": {
    "tracks": [{ "source": "externo", "volume": 1.0 }],
    "normalize": "two-pass"
  }
}
