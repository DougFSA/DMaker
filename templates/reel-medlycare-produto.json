{
  "description": "Reel de produto MedlyCare: cartão de abertura, capturas de tela com movimento e cartão de CTA.",
  "params": {
    "titulo": {
      "description": "Título do cartão de abertura",
      "default": "Sua agenda organizada em um clique",
      "type": "text"
    },
    "subtitulo": {
      "description": "Subtítulo do cartão de abertura",
      "default": "MedlyCare para clínicas e profissionais autônomos",
      "type": "text"
    },
    "prints": {
      "description": "Caminhos das capturas de tela do produto, na ordem em que aparecem",
      "type": "paths",
      "required": true
    },
    "cta_titulo": {
      "description": "Título do cartão de encerramento (chamada para ação)",
      "default": "Teste grátis por 3 meses, sem cartão",
      "type": "text"
    },
    "cta_subtitulo": {
      "description": "Subtítulo do cartão de encerramento",
      "default": "medlycare.com.br",
      "type": "text"
    },
    "musica": {
      "description": "Trilha instrumental de fundo (opcional)",
      "type": "path",
      "required": false
    },
    "legendas": {
      "description": "Gerar legendas automáticas",
      "default": false,
      "type": "bool"
    }
  },
  "name": "medlycare-produto-reel",
  "output": { "preset": "instagram/reels", "quality": "high" },
  "brand": "medlycare",
  "timeline": [
    { "type": "card", "title": "{{titulo}}", "subtitle": "{{subtitulo}}", "duration": 3.5 },
    {
      "$for": "prints",
      "as": "src",
      "item": {
        "type": "image",
        "src": "{{src}}",
        "duration": 4,
        "motion": "zoom-in",
        "transition": { "type": "fade", "duration": 0.5 }
      }
    },
    {
      "type": "card",
      "title": "{{cta_titulo}}",
      "subtitle": "{{cta_subtitulo}}",
      "variant": "dark",
      "duration": 4,
      "transition": { "type": "fade", "duration": 0.6 }
    }
  ],
  "overlays": [
    { "type": "image", "src": "logo:symbol", "position": "top-right", "width": 0.11, "start": 3.5 },
    { "type": "progress-bar" }
  ],
  "captions": {
    "$if": "{{legendas}}",
    "source": "auto",
    "language": "pt",
    "model": "small",
    "style": { "mode": "karaoke", "max_words": 4, "uppercase": true }
  },
  "audio": {
    "music": { "$if": "{{musica}}", "src": "{{musica}}", "volume": 0.15, "ducking": true, "fade_out": 2 },
    "normalize": "two-pass"
  }
}
