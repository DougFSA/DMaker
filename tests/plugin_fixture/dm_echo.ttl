@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://lv2plug.in/ns/extensions/units#> .

<urn:dmaker:test:echo>
    a lv2:Plugin, lv2:DelayPlugin ;
    doap:name "DMaker Eco de teste" ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 0 ;
        lv2:symbol "delay_ms" ;
        lv2:name "Atraso" ;
        lv2:default 250.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 1000.0 ;
        unit:unit unit:ms ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 1 ;
        lv2:symbol "feedback" ;
        lv2:name "Realimentacao" ;
        lv2:default 0.4 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.95 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "mix" ;
        lv2:name "Mistura" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "in" ;
        lv2:name "Entrada" ;
    ] , [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out" ;
        lv2:name "Saida" ;
    ] .
