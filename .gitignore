# ambiente e binários baixados pelo `dmaker setup`
.venv/
bin/
cache/
output/
*.log
.fetch.sh

# projetos de edição (vídeos-fonte e renders ficam fora do git)
projects/*/output/
projects/*/*.mp4
projects/*/*.mov
projects/*/*.wav
projects/*/*.mp3

# python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# sistema
Thumbs.db
desktop.ini

# layouts salvos da interface (dado da pessoa usando, não do repositório)
layouts.json
# predefinições de efeitos de áudio salvas pela pessoa (dado de quem usa o editor, não do repositório)
effect-presets.json
effect-presets.json.importado*

# plugins de efeito de terceiros (LV2 e LADSPA) que a pessoa pôs para o DMaker, e a lista dos que ela desligou
# (dado de quem usa o editor, não do repositório)
/plugins/
/plugins.json

# macros de áudio salvas pela pessoa, globais e de cada marca (dado de quem usa o editor, não do repositório)
assets/macros/
assets/brands/*/macros/

# vozes clonadas (referências são dados pessoais)
assets/voices/

# instaladores gerados por `dmaker release build` e os downloads que ele guarda (dezenas de GB)
releases/

# projetos de vídeo (mídia pesada e dados de clientes ficam só na máquina)
projects/

# conversas do agente local e os anexos delas (dado da pessoa); ancorado na raiz para não pegar pasta de código
/conversations/

# interface Vue: dependências e artefato de build (npm run build gera src/dmaker/ui/dist)
frontend/node_modules/
src/dmaker/ui/dist/
# o componente "projects" do front não é a pasta de projetos de vídeo
!frontend/src/components/projects/

# worktrees do Claude Code (cópias de trabalho de agentes, nunca vão para o git)
.claude/worktrees/
